<% content_for :title, t("app.sessions.title") %>

<div class="auth">
  <h1 class="page-title"><%= t("app.sessions.title") %></h1>
  <p class="page-lead"><%= t("app.sessions.lead", account: Current.account.name) %></p>

  <%= form_with url: login_path, class: "auth__form" do |form| %>
    <div class="field">
      <%= form.label :email, t("app.fields.email") %>
      <%= form.email_field :email, value: params[:email], autocomplete: "username", required: true, autofocus: true %>
    </div>
    <div class="field">
      <%= form.label :password, t("app.fields.password") %>
      <%= form.password_field :password, autocomplete: "current-password", required: true %>
    </div>
    <%= form.submit t("app.sessions.submit"), class: "button button--block" %>
  <% end %>

  <div class="auth__links">
    <%= link_to t("app.sessions.forgot"), new_password_reset_path %>
    <%= link_to t("app.sessions.pin"), speaker_login_path %>
  </div>
</div>
