<% ui = Language.listener_ui(@language) %>
<% content_for :title, "#{@language_info[:name]} · Hutba" %>

<main class="reader">
  <header class="reader__bar">
    <div class="reader__where">
      <p class="reader__mosque"><%= Current.account.name %></p>
      <p class="reader__status">
        <span class="status-dot" id="statusDot" aria-hidden="true"></span>
        <span id="connectionStatus"><%= ui[:connecting] %></span>
      </p>
    </div>
    <% if Current.account.languages.size > 1 %>
      <%= link_to listener_path, class: "reader__switch" do %>
        <span aria-hidden="true"><%= @language_info[:flag] %></span> <%= ui[:change] %>
      <% end %>
    <% end %>
  </header>

  <div class="translation-feed" id="translationFeed" aria-live="polite"
       data-language="<%= @language %>"
       data-connected-text="<%= ui[:connected] %>"
       data-disconnected-text="<%= ui[:disconnected] %>">
    <p class="no-translations"><%= ui[:waiting] %></p>
  </div>
</main>
