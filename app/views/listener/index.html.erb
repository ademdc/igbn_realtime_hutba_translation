<% content_for :title, "Hutba" %>

<main class="picker">
  <header class="picker__head">
    <p class="picker__mosque"><%= Current.account.name %></p>
    <h1 class="picker__title">Hutba</h1>
  </header>

  <ul class="picker__list">
    <% @languages.each do |code, info| %>
      <li>
        <%= link_to listener_language_path(language: code), class: "picker__option", lang: code, dir: Language.direction(code), data: { turbo: false } do %>
          <span class="picker__flag" aria-hidden="true"><%= info[:flag] %></span>
          <span>
            <span class="picker__name"><%= info[:name] %></span>
            <span class="picker__line"><%= info[:poster] %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <footer class="listener-footer">
    <span class="listener-footer__dot" aria-hidden="true"></span>hutba
  </footer>
</main>
