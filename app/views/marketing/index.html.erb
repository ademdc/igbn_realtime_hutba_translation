<%
  # Sample khutbah passage shown in the hero, in the languages an imam might speak
  # and the translations listeners would see.
  demo_script = [
    {
      "bs" => "Draga braćo i sestre, Allah nas u Kur'anu poziva na milost prema roditeljima.",
      "de" => "Liebe Brüder und Schwestern, Allah ruft uns im Koran zur Barmherzigkeit gegenüber unseren Eltern auf.",
      "en" => "Dear brothers and sisters, in the Qur'an Allah calls us to show mercy to our parents.",
      "fr" => "Chers frères et sœurs, dans le Coran, Allah nous appelle à la miséricorde envers nos parents.",
      "nl" => "Beste broeders en zusters, in de Koran roept Allah ons op tot barmhartigheid jegens onze ouders.",
      "tr" => "Aziz kardeşlerim, Allah Kur'an'da bizi anne babamıza merhametli olmaya çağırıyor.",
      "sq" => "Të dashur vëllezër dhe motra, Allahu në Kuran na thërret të jemi të mëshirshëm ndaj prindërve.",
      "ar" => "أيها الإخوة والأخوات الكرام، يدعونا الله في القرآن إلى الرحمة بالوالدين.",
      "ur" => "عزیز بھائیو اور بہنو، اللہ قرآن میں ہمیں والدین کے ساتھ رحم کرنے کی دعوت دیتا ہے۔"
    },
    {
      "bs" => "Oni su nas nosili dok nismo znali hodati.",
      "de" => "Sie haben uns getragen, als wir noch nicht laufen konnten.",
      "en" => "They carried us when we could not yet walk.",
      "fr" => "Ils nous ont portés quand nous ne savions pas encore marcher.",
      "nl" => "Zij droegen ons toen wij nog niet konden lopen.",
      "tr" => "Biz henüz yürüyemezken onlar bizi taşıdılar.",
      "sq" => "Ata na mbanin në krahë kur nuk dinim ende të ecnim.",
      "ar" => "لقد حملونا حين لم نكن نقدر على المشي بعد.",
      "ur" => "انہوں نے ہمیں اس وقت اٹھایا جب ہم ابھی چل بھی نہیں سکتے تھے۔"
    },
    {
      "bs" => "Danas, kada su oni stari i slabi, red je na nama.",
      "de" => "Heute, wo sie alt und schwach sind, sind wir an der Reihe.",
      "en" => "Today, now that they are old and weak, it is our turn.",
      "fr" => "Aujourd'hui, alors qu'ils sont âgés et faibles, c'est à notre tour.",
      "nl" => "Nu zij oud en zwak zijn, is het onze beurt.",
      "tr" => "Bugün, onlar yaşlı ve güçsüzken, sıra bizde.",
      "sq" => "Sot, kur ata janë të moshuar dhe të dobët, është radha jonë.",
      "ar" => "واليوم، وقد كبروا وضعفوا، جاء دورنا.",
      "ur" => "آج، جب وہ بوڑھے اور کمزور ہو گئے ہیں، اب ہماری باری ہے۔"
    }
  ]
  demo_languages = %w[de en fr nl tr sq]
  # Each sentence of the demo is spoken in the next of these, so visitors see more than Bosnian
  demo_sources = %w[bs ar tr sq ur]
  poster_languages = %w[de en nl]
%>

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title"><%= t("marketing.hero.title") %></h1>
      <p class="hero__lead"><%= t("marketing.hero.lead") %></p>
      <div class="hero__actions">
        <%= link_to t("marketing.hero.cta"), signup_path(locale: I18n.locale), class: "button" %>
        <p class="hero__note"><%= t("marketing.hero.note") %></p>
      </div>
    </div>

    <figure class="demo" data-demo data-language="<%= @demo_language %>" data-sources="<%= demo_sources.to_json %>" data-source-labels="<%= demo_sources.index_with { |code| t("marketing.demo.originals.#{code}") }.to_json %>" aria-label="<%= t("marketing.demo.label") %>">
      <script type="application/json" data-demo-script><%= raw json_escape(demo_script.to_json) %></script>

      <div class="demo__source">
        <p class="demo__status">
          <span class="live-badge"><span class="live-dot" aria-hidden="true"></span><%= t("marketing.demo.live") %></span>
          <span data-demo-source-label><%= t("marketing.demo.originals.bs") %></span>
        </p>
        <p class="demo__original" data-demo-original lang="bs"><%= demo_script.first["bs"] %></p>
      </div>

      <div class="demo__reading">
        <p class="demo__translation" data-demo-translation lang="<%= @demo_language %>"><%= demo_script.first[@demo_language] %></p>
      </div>

      <div class="demo__languages" role="group" aria-label="<%= t("marketing.demo.read_in") %>">
        <span class="demo__languages-label"><%= t("marketing.demo.read_in") %></span>
        <% demo_languages.each do |code| %>
          <button type="button" class="chip" data-demo-language="<%= code %>" aria-pressed="<%= code == @demo_language %>">
            <span aria-hidden="true"><%= Language.info(code)[:flag] %></span> <%= Language.info(code)[:name] %>
          </button>
        <% end %>
      </div>
    </figure>
  </div>
</section>

<section class="how" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <h2 class="section-title" id="how-title"><%= t("marketing.how.title") %></h2>

    <div class="how__layout">
      <ol class="steps">
        <% t("marketing.how.steps").each do |step| %>
          <li class="step">
            <h3 class="step__title"><%= step[:title] %></h3>
            <p><%= step[:text] %></p>
          </li>
        <% end %>
      </ol>

      <div class="poster" aria-hidden="true">
        <p class="poster__mosque">Džemat Demo</p>
        <p class="poster__title">Hutba</p>
        <ul class="poster__codes">
          <% poster_languages.each do |code| %>
            <li>
              <%= qr_code_svg("https://demo.#{AppDomain.host}/#{code}", size: 96) %>
              <span><%= Language.info(code)[:flag] %> <%= Language.info(code)[:name] %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="screen" aria-labelledby="screen-title">
  <div class="wrap screen__inner">
    <div>
      <h2 class="section-title" id="screen-title"><%= t("marketing.screen.title") %></h2>
      <p class="screen__text"><%= t("marketing.screen.text") %></p>
      <ul class="screen__points">
        <% t("marketing.screen.points").each do |point| %>
          <li><%= point %></li>
        <% end %>
      </ul>
    </div>

    <figure class="tv-mock" aria-hidden="true">
      <div class="tv-mock__screen">
        <p class="tv-mock__mosque">Džemat Demo</p>
        <p class="tv-mock__text"><span class="tv-mock__old"><%= demo_script[0][@demo_language] %></span> <%= demo_script[1][@demo_language] %></p>
        <div class="tv-mock__scan">
          <%= qr_code_svg("https://demo.#{AppDomain.host}/#{@demo_language}", size: 44) %>
          <span><%= Language.listener_ui(@demo_language)[:scan] %></span>
        </div>
      </div>
      <div class="tv-mock__stand"></div>
    </figure>
  </div>
</section>

<section class="benefits" aria-labelledby="benefits-title">
  <div class="wrap">
    <h2 class="section-title" id="benefits-title"><%= t("marketing.benefits.title") %></h2>
    <div class="benefits__list">
      <% t("marketing.benefits.items").each do |item| %>
        <div class="benefit">
          <h3><%= item[:title] %></h3>
          <p><%= item[:text] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap pricing__inner">
    <div class="pricing__head">
      <h2 class="section-title" id="pricing-title"><%= t("marketing.pricing.title") %></h2>
      <p class="pricing__plan"><%= t("marketing.pricing.plan") %></p>
      <p class="pricing__price"><%= t("marketing.pricing.price") %></p>
      <p class="pricing__per"><%= t("marketing.pricing.per") %></p>

      <div class="pricing__free">
        <p class="pricing__free-head">
          <span class="pricing__free-title"><%= t("marketing.pricing.free.title") %></span>
          <span class="pricing__free-price"><%= t("marketing.pricing.free.price") %></span>
          <span class="pricing__free-per"><%= t("marketing.pricing.free.per") %></span>
        </p>
        <ul class="pricing__free-list">
          <% t("marketing.pricing.free.includes").each do |line| %>
            <li><%= line %></li>
          <% end %>
        </ul>
        <p class="pricing__free-note"><%= t("marketing.pricing.free.note") %></p>
      </div>
    </div>
    <div class="pricing__body">
      <ul class="pricing__includes">
        <% t("marketing.pricing.includes").each do |line| %>
          <li><%= line %></li>
        <% end %>
      </ul>
      <p class="pricing__addon"><%= t("marketing.pricing.addon") %><br><%= t("marketing.pricing.addon_domain") %></p>
      <%= link_to t("marketing.pricing.cta"), signup_path(locale: I18n.locale), class: "button button--light" %>
      <p class="pricing__note"><%= t("marketing.pricing.note") %></p>
    </div>
  </div>
</section>

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__inner">
    <h2 class="section-title" id="faq-title"><%= t("marketing.faq.title") %></h2>
    <div class="faq__list">
      <% t("marketing.faq.items").each do |item| %>
        <details class="faq__item">
          <summary><%= item[:q] %></summary>
          <p><%= item[:a] %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>

<%# Structured data so search engines can show the product, its price and the FAQ as rich results %>
<%
  structured_data = [
    {
      "@context" => "https://schema.org",
      "@type" => "Organization",
      "name" => "Hutba",
      "url" => AppDomain.marketing_url,
      "logo" => "#{AppDomain.marketing_url}/og-image.png",
      "email" => Rails.configuration.x.contact_email
    },
    {
      "@context" => "https://schema.org",
      "@type" => "SoftwareApplication",
      "name" => "Hutba",
      "url" => marketing_url(locale: I18n.locale),
      "applicationCategory" => "CommunicationApplication",
      "operatingSystem" => "Web",
      "description" => t("marketing.meta.description"),
      "inLanguage" => I18n.locale.to_s,
      "offers" => [
        {
          "@type" => "Offer",
          "price" => "20.00",
          "priceCurrency" => "EUR",
          "description" => "#{t("marketing.pricing.price")} #{t("marketing.pricing.per")}"
        },
        {
          "@type" => "Offer",
          "price" => "0",
          "priceCurrency" => "EUR",
          "description" => t("marketing.pricing.free.includes").join(", ")
        }
      ]
    },
    {
      "@context" => "https://schema.org",
      "@type" => "FAQPage",
      "mainEntity" => t("marketing.faq.items").map { |item|
        { "@type" => "Question", "name" => item[:q], "acceptedAnswer" => { "@type" => "Answer", "text" => item[:a] } }
      }
    }
  ]
%>
<script type="application/ld+json"><%= raw json_escape(structured_data.to_json) %></script>
