<% content_for :title, t("app.speaker.login.title") %>

<div class="auth">
  <h1 class="page-title"><%= t("app.speaker.login.title") %></h1>
  <p class="page-lead"><%= t("app.speaker.login.lead", account: Current.account.name) %></p>

  <%= form_with url: speaker_authenticate_path, method: :post, class: "auth__form" do |form| %>
    <div class="field">
      <%= form.label :pin, t("app.speaker.login.pin") %>
      <%= form.password_field :pin, inputmode: "numeric", pattern: "[0-9]{4,8}", maxlength: 8, autocomplete: "off",
            autofocus: true, required: true, class: "pin-input", "aria-invalid": (@pin_error ? "true" : nil) %>
    </div>
    <%= form.submit t("app.speaker.login.submit"), class: "button button--block" %>
  <% end %>

  <div class="auth__links">
    <%= link_to t("app.speaker.login.email_login"), login_path %>
  </div>
</div>
