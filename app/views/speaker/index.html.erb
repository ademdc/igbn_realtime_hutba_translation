<% content_for :title, t("app.speaker.title") %>
<% content_for :head do %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
<% end %>
<%
  account = Current.account
  messages = t("app.speaker.messages").to_h
  language_names = Language::CATALOG.transform_values { |info| "#{info[:flag]} #{info[:name]}" }
%>

<div class="speaker" id="speakerPanel" data-state="idle"
     data-messages="<%= messages.to_json %>" data-language-names="<%= language_names.to_json %>">
  <div class="speaker__head">
    <div>
      <h1 class="page-title"><%= t("app.speaker.title") %></h1>
      <p class="page-lead"><%= t("app.speaker.lead", source: t("app.source_languages.#{account.source_language}"), languages: account.active_languages.map { |code| Language.info(code)[:name] }.to_sentence(locale: I18n.locale)) %></p>
    </div>
    <% unless current_user %>
      <%= button_to t("app.nav.sign_out"), speaker_logout_path, method: :delete, class: "link-button" %>
    <% end %>
  </div>

  <div class="speaker__grid">
    <section class="panel speaker__control" aria-labelledby="control-title">
      <h2 class="visually-hidden" id="control-title"><%= t("app.speaker.title") %></h2>

      <p class="speaker__badge" aria-hidden="true">
        <span class="live-dot"></span><%= t("app.speaker.live") %>
      </p>

      <% if account.can_stream? %>
        <button type="button" id="startRecording" class="record-button">
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-2.08A7 7 0 0 0 19 12h-2Z"/></svg>
          <span><%= t("app.speaker.start") %></span>
        </button>
        <button type="button" id="stopRecording" class="record-button record-button--stop" hidden>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor"/></svg>
          <span><%= t("app.speaker.stop") %></span>
        </button>
        <p id="status" class="speaker__status" role="status" aria-live="polite"><%= t("app.speaker.idle_hint") %></p>
      <% else %>
        <p class="flash flash--alert">
          <%= account.minutes_limit_reached? ? t("app.speaker.messages.limit_reached") : t("app.speaker.messages.unavailable") %>
        </p>
      <% end %>

      <p class="speaker__minutes muted"><%= t(account.free_plan? ? "app.speaker.minutes_left_month" : "app.speaker.minutes_left", count: account.minutes_left) %></p>
    </section>

    <section class="panel speaker__listeners" aria-labelledby="listeners-title">
      <h2 class="stat__label" id="listeners-title"><%= t("app.speaker.listeners") %></h2>
      <p class="speaker__total" id="totalListeners">0</p>
      <ul class="speaker__breakdown" id="statsBreakdown">
        <li class="muted"><%= t("app.speaker.messages.no_listeners") %></li>
      </ul>
    </section>
  </div>

  <section class="hears" id="transcriptionBox" aria-labelledby="hears-title" hidden>
    <h2 class="hears__title" id="hears-title"><%= t("app.speaker.hears") %></h2>
    <p class="hears__text" id="transcription" lang="<%= account.source_language %>" dir="<%= Language.direction(account.source_language) %>"></p>
  </section>

  <section class="panel speaker__help" aria-labelledby="help-title">
    <h2 class="panel__title" id="help-title"><%= t("app.speaker.help_title") %></h2>
    <ol>
      <% t("app.speaker.steps").each do |step| %>
        <li><%= step %></li>
      <% end %>
    </ol>
  </section>
</div>
