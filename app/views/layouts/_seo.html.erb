<% title = content_for(:title).presence || t("marketing.meta.title") %>
<% description = content_for(:description).presence || t("marketing.meta.description") %>
<%# Always the apex host, so www.hutba.app counts as the same site %>
<% canonical = AppDomain.marketing_url(request.path) %>
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<meta name="keywords" content="<%= t("marketing.meta.keywords") %>">
<% if content_for?(:noindex) %>
  <meta name="robots" content="noindex">
<% else %>
  <link rel="canonical" href="<%= canonical %>">
  <% alternates = marketing_alternates.slice(*(@hreflang_locales || MarketingController::LOCALES)) %>
  <% alternates.each do |locale, path| %>
    <link rel="alternate" hreflang="<%= locale %>" href="<%= AppDomain.marketing_url(path) %>">
  <% end %>
  <link rel="alternate" hreflang="x-default" href="<%= AppDomain.marketing_url(alternates["de"] || alternates.values.first) %>">
<% end %>

<%# Link previews in WhatsApp, Facebook, Telegram, X %>
<meta property="og:type" content="<%= content_for(:og_type).presence || "website" %>">
<meta property="og:site_name" content="Hutba">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:locale" content="<%= t("marketing.meta.og_locale") %>">
<meta property="og:image" content="<%= AppDomain.marketing_url("/og-image.png") %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= t("marketing.meta.title") %>">
<meta name="twitter:card" content="summary_large_image">
