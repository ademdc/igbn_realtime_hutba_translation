<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#12302d">
    <%= render "layouts/seo" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag "marketing", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "marketing", type: "module", defer: true %>
  </head>

  <body class="marketing">
    <a class="skip-link" href="#main"><%= t("marketing.nav.skip") %></a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <%= link_to marketing_path(locale: I18n.locale), class: "wordmark", "aria-label": "Hutba" do %>
          <span class="wordmark__dot" aria-hidden="true"></span>hutba
        <% end %>

        <nav class="site-nav" aria-label="Main">
          <a href="<%= marketing_path(locale: I18n.locale) %>#how"><%= t("marketing.nav.how") %></a>
          <a href="<%= marketing_path(locale: I18n.locale) %>#pricing"><%= t("marketing.nav.pricing") %></a>
          <a href="<%= marketing_path(locale: I18n.locale) %>#faq"><%= t("marketing.nav.faq") %></a>
          <%= link_to t("marketing.nav.blog"), blog_path(locale: I18n.locale) %>
        </nav>

        <details class="locale-switch">
          <summary aria-label="<%= t("marketing.nav.language") %>"><%= I18n.locale.upcase %></summary>
          <ul>
            <% { "de" => "Deutsch", "en" => "English", "fr" => "Français", "nl" => "Nederlands", "bs" => "Bosanski", "tr" => "Türkçe" }.each do |locale, name| %>
              <li>
                <%= link_to name, marketing_alternates[locale], lang: locale, hreflang: locale,
                      "aria-current": (locale == I18n.locale.to_s ? "true" : nil) %>
              </li>
            <% end %>
          </ul>
        </details>

        <%= link_to t("marketing.nav.login"), marketing_login_path(locale: I18n.locale), class: "site-header__login" %>
        <%= link_to t("marketing.nav.cta"), signup_path(locale: I18n.locale), class: "button button--small site-header__cta" %>
      </div>
    </header>

    <main id="main">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div>
          <p class="wordmark wordmark--small"><span class="wordmark__dot" aria-hidden="true"></span>hutba</p>
          <p class="site-footer__tagline"><%= t("marketing.footer.tagline") %></p>
        </div>
        <nav aria-label="Footer">
          <%= link_to t("marketing.nav.blog"), blog_path(locale: I18n.locale) %>
          <%= link_to t("marketing.footer.imprint"), marketing_imprint_path(locale: I18n.locale) %>
          <%= link_to t("marketing.footer.privacy"), marketing_privacy_path(locale: I18n.locale) %>
          <%= mail_to Rails.configuration.x.contact_email, t("marketing.footer.contact") %>
        </nav>
      </div>
    </footer>
  </body>
</html>
