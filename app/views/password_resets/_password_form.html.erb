<%= render "shared/errors", record: @user %>

<%= form_with model: @user, url: url, method: :patch, class: "auth__form" do |form| %>
  <div class="field">
    <%= form.label :password, t("app.fields.new_password") %>
    <%= form.password_field :password, autocomplete: "new-password", required: true, minlength: 10, autofocus: true, "aria-describedby": "password-hint" %>
    <p class="field__hint" id="password-hint"><%= t("app.fields.password_hint") %></p>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, t("app.fields.password_confirmation") %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true %>
  </div>
  <%= form.submit submit_label, class: "button button--block" %>
<% end %>
