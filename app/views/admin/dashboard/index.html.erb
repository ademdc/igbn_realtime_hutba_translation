<% content_for :title, "Overview" %>

<h1 class="page-title">Overview</h1>

<div class="kpis">
  <section class="panel kpi">
    <h2 class="kpi__label">Monthly recurring revenue</h2>
    <p class="kpi__value"><%= number_to_currency(@mrr_cents / 100.0, unit: "€", format: "%u%n", precision: 0) %></p>
    <p class="kpi__note"><%= number_to_currency(@mrr_cents * 12 / 100.0, unit: "€", format: "%u%n", precision: 0) %> per year</p>
  </section>
  <section class="panel kpi">
    <h2 class="kpi__label">Paying mosques</h2>
    <p class="kpi__value"><%= @accounts_paying %></p>
    <p class="kpi__note"><%= @conversion ? "#{@conversion}% of finished trials converted" : "No finished trials yet" %></p>
  </section>
  <section class="panel kpi">
    <h2 class="kpi__label">In trial</h2>
    <p class="kpi__value"><%= @accounts_trialing %></p>
    <p class="kpi__note"><%= @accounts_expired %> expired, unpaid</p>
  </section>
  <section class="panel kpi">
    <h2 class="kpi__label">Signups, last 30 days</h2>
    <p class="kpi__value"><%= @signups_30_days %></p>
    <p class="kpi__note"><%= @accounts_total %> accounts in total</p>
  </section>
</div>

<% if @awaiting_transfers.any? %>
  <section class="panel" style="margin-top: 1.5rem;">
    <h2 class="panel__title">Bank transfers to confirm (<%= @awaiting_transfers.size %>)</h2>
    <%= render "admin/payments/awaiting", payments: @awaiting_transfers, show_account: true %>
  </section>
<% end %>

<div class="section-head">
  <h2>Live now</h2>
  <%= button_to "Reset all live sessions", admin_reset_all_path, method: :post, class: "link-button",
        form: { onsubmit: "return confirm('Mark all active speakers and listeners as ended?')" } %>
</div>
<div class="two-col">
  <section class="panel">
    <h3 class="panel__title">Broadcasts (<%= @active_speakers.size %>)</h3>
    <% if @active_speakers.any? %>
      <table class="table">
        <tbody>
          <% @active_speakers.each do |session| %>
            <tr>
              <td><span class="live-dot" aria-hidden="true"></span><%= link_to session.account.name, admin_account_path(session.account) %></td>
              <td class="num"><%= distance_of_time_in_words(session.started_at, Time.current) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="muted">Nobody is broadcasting right now.</p>
    <% end %>
  </section>
  <section class="panel">
    <h3 class="panel__title">Listeners (<%= @active_listeners %>)</h3>
    <% if @active_listeners_by_language.any? %>
      <table class="table">
        <tbody>
          <% @active_listeners_by_language.sort_by { |_, count| -count }.each do |language, count| %>
            <tr>
              <td><%= Language.info(language)&.dig(:flag) %> <%= Language.info(language)&.dig(:name) || language %></td>
              <td class="num"><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="muted">No listeners connected.</p>
    <% end %>
  </section>
</div>

<div class="section-head">
  <h2>This week</h2>
</div>
<div class="kpis">
  <section class="panel kpi">
    <h3 class="kpi__label">Broadcasts</h3>
    <p class="kpi__value"><%= @week_sessions %></p>
  </section>
  <section class="panel kpi">
    <h3 class="kpi__label">Minutes broadcast</h3>
    <p class="kpi__value"><%= @week_minutes %></p>
  </section>
  <section class="panel kpi">
    <h3 class="kpi__label">Listener connections</h3>
    <p class="kpi__value"><%= @week_listeners %></p>
  </section>
</div>

<div class="two-col">
  <section>
    <div class="section-head"><h2>Newest accounts</h2><%= link_to "All accounts", admin_accounts_path %></div>
    <div class="panel">
      <table class="table">
        <tbody>
          <% @recent_accounts.each do |account| %>
            <tr>
              <td><%= link_to account.name, admin_account_path(account) %><br><span class="muted"><%= [account.city, account.country].compact_blank.join(", ") %></span></td>
              <td><%= render "admin/shared/status", account: account %></td>
              <td class="num muted"><%= l(account.created_at.to_date, format: :short) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
  <section>
    <div class="section-head"><h2>Trials ending in 14 days</h2></div>
    <div class="panel">
      <% if @trials_ending.any? %>
        <table class="table">
          <tbody>
            <% @trials_ending.each do |account| %>
              <tr>
                <td><%= link_to account.name, admin_account_path(account) %></td>
                <td class="num"><%= pluralize(account.trial_days_left, "day") %> left</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="muted">No trials ending soon.</p>
      <% end %>
    </div>
  </section>
</div>
