<% content_for :title, "#{@post.title} – Hutba" %>
<% content_for :description, @post.description %>
<% content_for :og_type, "article" %>

<article class="article">
  <div class="wrap">
    <p class="article__back"><%= link_to t("marketing.blog.back"), blog_path(locale: I18n.locale) %></p>
    <h1 class="article__title"><%= @post.title %></h1>
    <p class="article__date"><time datetime="<%= @post.date.iso8601 %>"><%= l(@post.date, format: :long) %></time></p>

    <div class="article__body">
      <%= @post.html %>
    </div>

    <aside class="article__cta">
      <p><%= t("marketing.blog.cta_text") %></p>
      <%= link_to t("marketing.hero.cta"), signup_path(locale: I18n.locale), class: "button" %>
    </aside>
  </div>
</article>

<%
  structured_data = {
    "@context" => "https://schema.org",
    "@type" => "BlogPosting",
    "headline" => @post.title,
    "description" => @post.description,
    "datePublished" => @post.date.iso8601,
    "inLanguage" => @post.locale,
    "mainEntityOfPage" => AppDomain.marketing_url(request.path),
    "image" => AppDomain.marketing_url("/og-image.png"),
    "author" => { "@type" => "Organization", "name" => "Hutba", "url" => AppDomain.marketing_url },
    "publisher" => { "@type" => "Organization", "name" => "Hutba", "logo" => { "@type" => "ImageObject", "url" => AppDomain.marketing_url("/og-image.png") } }
  }
%>
<script type="application/ld+json"><%= raw json_escape(structured_data.to_json) %></script>
